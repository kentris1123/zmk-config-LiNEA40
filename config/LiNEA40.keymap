#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT  0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define TRI      4
#define SCROLL   5
#define WIRELESS 6

/* Keep the established Planck mod-tap timing for non-home-row mod-taps. */
&mt {
    tapping-term-ms = <140>;
};

&soft_off {
    hold-time-ms = <1000>;
};

/* Mouse cursor */
&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

/* Mouse scroll */
&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <TRI>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lower_raise {
            if-layers = <LOWER RAISE>;
            then-layer = <TRI>;
        };
    };

    behaviors {
        /*
         * Latest Corne-ish Zen home-row-mod tuning:
         * - 200 ms balanced hold-tap
         * - opposite-hand interruptions only
         * - ignore rolls that start within 150 ms of the previous key
         */
        lh_mt: left_hand_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_MT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        rh_mt: right_hand_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_MT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Planck's two outside columns are omitted on LiNEA40. */
        default_layer {
            bindings = <
&kp Q          &kp W         &kp E         &kp R          &kp T                      &kp Y  &kp U          &kp I             &kp O           &kp P
&kp A          &kp S         &kp D         &kp F          &kp G                      &kp H  &kp J          &kp K             &kp L           &kp SEMI
&lh_mt LSHFT Z &lh_mt LGUI X &lh_mt LALT C &lh_mt LCTRL V &kp B                      &kp N  &rh_mt RCTRL M &rh_mt RALT COMMA &rh_mt RGUI DOT &rh_mt RSHFT FSLH
&mt LCTRL ESC  &kp LGUI      &mt LALT GRAVE &mo RAISE     &lt SCROLL RET  &lt LOWER TAB  &lt LOWER BSPC  &lt TRI SPACE  &lt WIRELESS RBKT  &kp BSLH  &mt RSHFT EQUAL
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        /* Layer 1 is retained for PMW3610 automouse behavior. */
        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;
        };

        lower_layer {
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE    &kp KP_NUMLOCK                    &none          &none         &none         &kp GRAVE     &kp LS(GRAVE)
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &kp MINUS                         &kp EQUAL      &kp LBKT      &kp RBKT      &kp APOS      &kp BACKSLASH
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS     &kp LS(MINUS)                     &kp LS(EQUAL)  &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(APOS)  &kp LS(BACKSLASH)
&trans           &trans           &trans           &kp KP_NUMBER_0  &kp KP_PLUS  &kp KP_ENTER  &trans  &trans         &trans         &trans        &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        raise_layer {
            bindings = <
&kp PAGE_DOWN  &kp PAGE_UP  &kp LA(TAB)  &kp HOME   &kp END                    &kp F11  &kp F12  &none   &none   &none
&kp DEL        &kp TAB      &kp UP       &kp BSPC   &kp RET                    &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp INS        &kp LEFT     &kp DOWN     &kp RIGHT  &kp ESC                    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&trans         &trans       &trans       &trans     &trans   &trans    &trans  &trans           &trans  &trans  &trans
            >;
        };

        tri_layer {
            bindings = <
&kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &soft_off  &bt BT_CLR                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp N1      &kp N2             &kp N3           &kp N4     &kp N5                        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
&kp LS(N1)  &kp LS(N2)         &kp LS(N3)       &kp LS(N4) &kp LS(N5)                    &kp LS(N6)    &kp LS(N7)    &kp LS(N8)    &kp LS(N9)    &kp LS(N0)
&trans      &trans             &trans           &trans     &trans      &trans    &trans  &trans         &trans         &trans         &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        scroll_layer {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        wireless_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
