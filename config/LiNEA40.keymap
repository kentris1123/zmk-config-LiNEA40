#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT  0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define TRI      4
#define SCROLL   5
#define WIRELESS 6

/* Keep the established Planck mod-tap timing for non-home-row mod-taps. */

&mt { tapping-term-ms = <140>; };

&soft_off { hold-time-ms = <1000>; };

/* Mouse cursor */

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

/* Mouse scroll */

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <TRI>;
        input-processors = <&zip_wheel_scaler 3 1>;
    };
};

&trackball_listener {
    scroller {
        layers = <LOWER>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 2>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lower_raise {
            if-layers = <LOWER RAISE>;
            then-layer = <TRI>;
        };
    };

    behaviors {
        /*
         * Latest Corne-ish Zen home-row-mod tuning:
         * - 200 ms balanced hold-tap
         * - opposite-hand interruptions only
         * - ignore rolls that start within 150 ms of the previous key
         */

        lh_mt: left_hand_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_MT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        rh_mt: right_hand_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_MT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Planck's two outside columns are omitted on LiNEA40. */

        default_layer {
            bindings = <
&kp Q            &kp W          &kp E           &kp R      &kp T                           &kp Y  &kp U  &kp I           &kp O         &kp P
&kp A            &kp S          &kp D           &kp F      &kp G                           &kp H  &kp J  &kp K           &kp L         &kp SEMI
&kp Z            &kp X          &kp C           &kp V      &kp B                           &kp N  &kp M  &kp COMMA       &kp PERIOD    &kp FSLH
&mt LCTRL GRAVE  &mt LALT RBKT  &mt LGUI MINUS  &kp SPACE  &mo 2  &kp LSHIFT    &kp RSHFT  &mo 3         &mt RGUI EQUAL  &mt RALT SQT  &mt RCTRL LBKT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        /* Layer 1 is retained for PMW3610 automouse behavior. */

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;
        };

        lower_layer {
            bindings = <
&kp HOME   &kp END   &kp TAB   &kp DEL    &kp INS                      &none   &none     &trans    &none     &none
&kp PG_UP  &kp TAB   &kp UP    &kp BSPC   &kp ENTER                    &none   &mkp MB1  &mkp MB3  &mkp MB2  &none
&kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp ESC                      &none   &none     &none     &none     &none
&trans     &trans    &trans    &trans     &trans     &trans    &trans  &trans            &trans    &trans    &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        raise_layer {
            bindings = <
&kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
&kp N1    &kp N2  &kp N3    &kp N4    &kp N5                       &kp N6     &kp N7    &kp N8    &kp N9    &kp N0
&kp F1    &kp F2  &kp F3    &kp F4    &kp F5                       &kp F6     &kp F7    &kp F8    &kp F9    &kp F10
&trans    &trans  &trans    &trans    &trans     &trans    &trans  &trans               &trans    &kp F11   &kp F12
            >;
        };

        tri_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_CLR  &trans  &trans  &trans  &trans
&kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE    &trans        &trans                          &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                          &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans              &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        wireless_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
